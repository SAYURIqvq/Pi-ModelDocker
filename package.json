{
  "name": "pi-modeldocker-core",
  "version": "0.1.2",
  "private": true,
  "description": "Pi ModelDocker 是一个支持 pi-ai 适配的轻量级多平台模型调用框架，统一管理平台、模型与 API 密钥引用，提供文本与图片输入、流式输出和统一错误处理，让业务通过一套接口接入不同模型。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/adapters/pi.d.ts",
      "import": "./dist/adapters/pi.js"
    }
  },
  "bin": {
    "pi-modeldocker": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test",
    "cli": "node dist/cli.js",
    "pretest": "npm run build"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.99.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
